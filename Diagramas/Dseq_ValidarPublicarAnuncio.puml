@startuml
title Diagrama de Sequência - Validar / Publicar Anúncio

actor Administrador

boundary PaginaValidacaoAnuncio
control GestorAnuncio
entity AnuncioMarketplace

Administrador -> PaginaValidacaoAnuncio : consultarAnunciosPendentes()
activate Administrador
activate PaginaValidacaoAnuncio

PaginaValidacaoAnuncio -> GestorAnuncio : obterAnunciosPendentes()
activate GestorAnuncio

GestorAnuncio -> AnuncioMarketplace : listarPendentes()
activate AnuncioMarketplace
AnuncioMarketplace --> GestorAnuncio : listaAnuncios
deactivate AnuncioMarketplace

GestorAnuncio --> PaginaValidacaoAnuncio : apresentarLista()
deactivate GestorAnuncio

Administrador -> PaginaValidacaoAnuncio : selecionarAnuncio(anuncioID)

PaginaValidacaoAnuncio -> GestorAnuncio : validarAnuncio(anuncioID)
activate GestorAnuncio

GestorAnuncio -> AnuncioMarketplace : aprovarAnuncio(anuncioID)
activate AnuncioMarketplace
AnuncioMarketplace --> GestorAnuncio : estadoAtualizado
deactivate AnuncioMarketplace

GestorAnuncio --> PaginaValidacaoAnuncio : confirmarPublicacao()
deactivate GestorAnuncio

PaginaValidacaoAnuncio --> Administrador : anuncioPublicado()

deactivate PaginaValidacaoAnuncio
deactivate Administrador

@enduml