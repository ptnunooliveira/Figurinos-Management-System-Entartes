@startuml
title Diagrama de Sequência - Registar Levantamento (Detalhado ao Código)

autonumber

actor Funcionario
boundary "UI: Levantamento\n(levantamento.tsx)" as UI
control "Service API\n(services.ts)" as APIService
control "checklistController" as Controller
control "checklistService" as Service
database "Prisma ORM" as DB

Funcionario -> UI : Preenche checklist e Clica "Confirmar Levantamento"
activate UI

UI -> APIService : criarChecklist(idReserva, dados (tipo=1))
activate APIService

APIService -> Controller : POST /reservas/{id}/checklists
activate Controller

Controller -> Service : criarChecklist(idFuncionario, dadosChecklist, idReserva)
activate Service

Service -> DB : reserva.findUnique(idReserva)
loop Para cada item na checklist
    Service -> DB : linha_reserva.findFirst(id_linha_reserva)
    Service -> Service : Validar se a linha pertence à reserva\ne se o figurino corresponde
end

Service -> DB : checklist.create(inclui checklist_item.create())
Service -> DB : linha_reserva.updateMany(id_estado_linha_reserva = 3)
Service -> DB : reserva.update(id_estado = 3)

Service --> Controller : novaChecklist
deactivate Service
Controller --> APIService : HTTP 201 Created (JSON)
deactivate Controller
APIService --> UI : Promise <novaChecklist>
deactivate APIService
UI --> Funcionario : toast.success("Levantamento registado com sucesso!")
deactivate UI
@enduml